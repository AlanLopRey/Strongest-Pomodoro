    "@testing-library/jest-native": "5.4.3",
    "@testing-library/react-native": "12.5.2",
    "@types/jest": "29.5.12",
    "@types/react": "~18.2.45",
    "@types/react-test-renderer": "18.0.7",
    "eslint-plugin-testing-library": "6.2.2",
